{
  "name": "second-pass",
  "productName": "Second Pass",
  "version": "1.1.1",
  "description": "Edit text and images directly in HTML pages, with Codex beside you.",
  "author": "Richard Mancuso",
  "homepage": "https://richardirg.github.io/second-pass/",
  "repository": { "type": "git", "url": "https://github.com/richardIRG/second-pass.git" },
  "packageManager": "pnpm@10.18.2",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "prepare:codex": "node scripts/prepare-codex.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm package && playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "chokidar": "5.0.0",
    "electron-squirrel-startup": "1.0.1",
    "magic-string": "^1.2.2",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.4.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "macos-alias"],
    "peerDependencyRules": {
      "allowedVersions": {
        "@electron/fuses": "2.1.3"
      }
    }
  }
}
